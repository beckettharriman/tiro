{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tiro",
  "identifier": "dev.tiro.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Tiro",
        "url": "index.html",
        "width": 800,
        "height": 560,
        "minWidth": 800,
        "minHeight": 560,
        "maxWidth": 800,
        "maxHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "pill",
        "title": "Tiro Pill",
        "url": "pill.html",
        "width": 300,
        "height": 76,
        "minWidth": 300,
        "minHeight": 76,
        "maxWidth": 300,
        "maxHeight": 76,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "shortDescription": "Always-on offline dictation to your clipboard",
    "longDescription": "Tiro listens on a global hotkey, transcribes speech locally with Whisper, and puts the text on your clipboard. Fully offline.",
    "category": "Utility",
    "publisher": "Beckett Harriman",
    "homepage": "https://github.com/beckettharriman/tiro",
    "license": "GPL-3.0-only",
    "linux": {
      "deb": {
        "depends": ["libasound2"],
        "files": {
          "/usr/share/applications/dev.tiro.app.desktop": "linux/dev.tiro.app.desktop"
        }
      },
      "rpm": {
        "depends": ["alsa-lib"],
        "files": {
          "/usr/share/applications/dev.tiro.app.desktop": "linux/dev.tiro.app.desktop"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
