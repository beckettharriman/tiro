{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tiro",
  "version": "0.1.0",
  "identifier": "dev.tiro.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Tiro",
        "url": "index.html",
        "width": 400,
        "height": 560,
        "minWidth": 400,
        "minHeight": 560,
        "maxWidth": 400,
        "maxHeight": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "pill",
        "title": "Tiro Pill",
        "url": "pill.html",
        "width": 300,
        "height": 72,
        "minWidth": 300,
        "minHeight": 72,
        "maxWidth": 300,
        "maxHeight": 72,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
